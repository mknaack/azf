(** Where a resource is deployed.

    There is one constructor per Azure region, named after its display name
    (e.g. [West_europe] for ["westeurope"]). Regions not listed here can be
    given by name with [Region]. *)

type t =
  | Resource_group
      (** The resource group's location, [resourceGroup().location]. *)
  | East_asia  (** [eastasia], East Asia *)
  | Southeast_asia  (** [southeastasia], Southeast Asia *)
  | Central_us  (** [centralus], Central US *)
  | East_us  (** [eastus], East US *)
  | East_us_2  (** [eastus2], East US 2 *)
  | West_us  (** [westus], West US *)
  | West_us_2  (** [westus2], West US 2 *)
  | West_us_3  (** [westus3], West US 3 *)
  | North_central_us  (** [northcentralus], North Central US *)
  | South_central_us  (** [southcentralus], South Central US *)
  | North_europe  (** [northeurope], North Europe *)
  | West_europe  (** [westeurope], West Europe *)
  | Japan_west  (** [japanwest], Japan West *)
  | Japan_east  (** [japaneast], Japan East *)
  | Brazil_south  (** [brazilsouth], Brazil South *)
  | Australia_east  (** [australiaeast], Australia East *)
  | Australia_southeast  (** [australiasoutheast], Australia Southeast *)
  | South_india  (** [southindia], South India *)
  | Central_india  (** [centralindia], Central India *)
  | West_india  (** [westindia], West India *)
  | Canada_central  (** [canadacentral], Canada Central *)
  | Canada_east  (** [canadaeast], Canada East *)
  | Uk_south  (** [uksouth], UK South *)
  | Uk_west  (** [ukwest], UK West *)
  | West_central_us  (** [westcentralus], West Central US *)
  | Korea_central  (** [koreacentral], Korea Central *)
  | Korea_south  (** [koreasouth], Korea South *)
  | France_central  (** [francecentral], France Central *)
  | France_south  (** [francesouth], France South *)
  | Australia_central  (** [australiacentral], Australia Central *)
  | Australia_central_2  (** [australiacentral2], Australia Central 2 *)
  | Uae_central  (** [uaecentral], UAE Central *)
  | Uae_north  (** [uaenorth], UAE North *)
  | South_africa_north  (** [southafricanorth], South Africa North *)
  | South_africa_west  (** [southafricawest], South Africa West *)
  | Sweden_central  (** [swedencentral], Sweden Central *)
  | Sweden_south  (** [swedensouth], Sweden South *)
  | Switzerland_north  (** [switzerlandnorth], Switzerland North *)
  | Switzerland_west  (** [switzerlandwest], Switzerland West *)
  | Germany_north  (** [germanynorth], Germany North *)
  | Germany_west_central  (** [germanywestcentral], Germany West Central *)
  | Germany_central  (** [germanycentral], Germany Central *)
  | Germany_northeast  (** [germanynortheast], Germany Northeast *)
  | Norway_west  (** [norwaywest], Norway West *)
  | Norway_east  (** [norwayeast], Norway East *)
  | Brazil_southeast  (** [brazilsoutheast], Brazil Southeast *)
  | China_north  (** [chinanorth], China North *)
  | China_east  (** [chinaeast], China East *)
  | China_north_2  (** [chinanorth2], China North 2 *)
  | China_north_3  (** [chinanorth3], China North 3 *)
  | China_east_2  (** [chinaeast2], China East 2 *)
  | China_east_3  (** [chinaeast3], China East 3 *)
  | Qatar_central  (** [qatarcentral], Qatar Central *)
  | Us_dod_central  (** [usdodcentral], US DoD Central *)
  | Us_dod_east  (** [usdodeast], US DoD East *)
  | Us_gov_arizona  (** [usgovarizona], US Gov Arizona *)
  | Us_gov_texas  (** [usgovtexas], US Gov Texas *)
  | Us_gov_virginia  (** [usgovvirginia], US Gov Virginia *)
  | Us_gov_iowa  (** [usgoviowa], US Gov Iowa *)
  | Israel_central  (** [israelcentral], Israel Central *)
  | Italy_north  (** [italynorth], Italy North *)
  | Poland_central  (** [polandcentral], Poland Central *)
  | Mexico_central  (** [mexicocentral], Mexico Central *)
  | Spain_central  (** [spaincentral], Spain Central *)
  | Indonesia_central  (** [indonesiacentral], Indonesia Central *)
  | New_zealand_north  (** [newzealandnorth], New Zealand North *)
  | Malaysia_west  (** [malaysiawest], Malaysia West *)
  | Denmark_east  (** [denmarkeast], Denmark East *)
  | Region of string
      (** Any other region, by name, e.g. [Region "austriaeast"]. *)
  | Parameter of string Parameter.t
      (** Chosen when the template is deployed. *)

val to_expression : t -> string Arm_expression.t
(** The ARM value for the location, e.g. ["westeurope"] or
    [[resourceGroup().location]]. *)
