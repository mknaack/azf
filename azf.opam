# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "OCaml DSL for generating Azure ARM templates"
description:
  "An OCaml port of Farmer: build Azure resources with composable, type-safe builders and emit ARM template JSON."
maintainer: ["Morten Knaack <knaack@gmail.com>"]
authors: ["Morten Knaack <knaack@gmail.com>"]
license: "MIT"
homepage: "https://github.com/mknaack/azf"
bug-reports: "https://github.com/mknaack/azf/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.17"}
  "yojson" {>= "2.0"}
  "ppx_yojson_conv" {>= "v0.16"}
  "ppx_expect" {with-test}
  "odoc" {with-doc}
  "ocamlformat" {with-dev-setup & = "0.28.1"}
  "ocaml-lsp-server" {with-dev-setup}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/mknaack/azf.git"
